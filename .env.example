# ==============================================================================
# DEV VISUALIZER — Variables de Entorno de Configuración (.env.example)
# ==============================================================================
# Este archivo documenta las variables de entorno configurables para el proyecto.
# Para desarrollo local, copie este archivo a `.env.local` y ajuste los valores.
#
#   cp .env.example .env.local
#
# NOTA DE SEGURIDAD:
# Las variables con el prefijo `NEXT_PUBLIC_` son accesibles en el navegador y
# se incorporan al bundle del cliente estático durante la compilación (`npm run build`).
# NUNCA coloque contraseñas, secretos privados ni API keys confidenciales aquí.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. URL CANÓNICA Y ENRUTAMIENTO BASE
# ------------------------------------------------------------------------------

# URL absoluta base para la generación de metadatos canónicos, Open Graph,
# Twitter Cards, sitemap.xml y nodos institucionales de Schema.org JSON-LD.
#
# - Producción (GitHub Pages): https://luics415.github.io/Dev-Visualizer
# - Dominio personalizado:      https://dev-visualizer.com
# - Desarrollo local:           http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://luics415.github.io/Dev-Visualizer

# Prefijo de subcarpeta base si la aplicación se despliega en un subdirectorio
# (como en GitHub Pages para repositorios de proyecto: /<repo-name>).
# Para desarrollo local o dominio raíz personalizado, debe mantenerse vacío.
#
# - Producción (GitHub Pages): /Dev-Visualizer
# - Dominio raíz o local dev:   (dejar vacío: NEXT_PUBLIC_BASE_PATH=)
NEXT_PUBLIC_BASE_PATH=/Dev-Visualizer


# ------------------------------------------------------------------------------
# 2. ANALÍTICA WEB Y TELEMETRÍA DE APRENDIZAJE
# ------------------------------------------------------------------------------

# Identificador de medición de Google Analytics 4 (GA4).
# Se utiliza en `@next/third-parties/google` para inicializar el script gtag.js
# y rastrear interacciones de telemetría (colecciones, botones, permanencia).
# Formato: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-K3GRNYB3K6


# ------------------------------------------------------------------------------
# 3. VERIFICACIÓN DE MOTORES DE BÚSQUEDA Y FICHA DE NEGOCIO (SEO)
# ------------------------------------------------------------------------------

# Código alfanumérico de verificación para Google Search Console mediante metatag HTML.
# Al configurarse, Next.js genera: <meta name="google-site-verification" content="..." />
# Dejar vacío o comentar si no se requiere verificación en el entorno actual.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Token de verificación o vinculación para Google Business Profile (Ficha de negocio).
# Permite asociar la entidad educativa o solicitar verificación instantánea
# complementaria a través de Search Console.
# Dejar vacío o comentar si no se requiere.
NEXT_PUBLIC_GOOGLE_BUSINESS_VERIFICATION=


# ------------------------------------------------------------------------------
# 4. HERRAMIENTAS DE AUTOMATIZACIÓN Y CI/CD (OPCIONAL)
# ------------------------------------------------------------------------------

# Token personal de GitHub (PAT) con permisos de escritura para la sincronización
# y publicación de documentación wiki automática (`scripts/push-wiki.mjs`).
# Requerido únicamente en flujos de scripts CLI externos, no en el runtime web.
# GITHUB_TOKEN=ghp_exampleTokenForWikiPushOnly
